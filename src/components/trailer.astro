>
    <div class="relative">
        <h1 class="font-bold text-3xl md:text-4xl text-white">Game Trailer</h1>
    </div>

    <!-- <iframe
        loading="lazy"
        class="w-full aspect-video max-w-3xl"
        src="https://www.youtube.com/embed/sgWAqelrR18?si=JBAc3swTzwDKsgwh"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe> -->
    <iframe
        loading="lazy"
        class="w-full aspect-video max-w-3xl"
        src="https://www.youtube.com/embed/aecM46pe8c0?si=7VLrUNj0EbALW-Y1"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>

    <p class="text-white text-sm md:text-base">
