---
import Image from "astro/components/Image.astro";
import LineEffect from "../assets/others/Line Effect.webp";
---

<section
    class="w-full h-screen flex flex-col gap-5 items-center justify-center px-3 md:px-0"
>
    <div class="relative">
        <h1 class="font-bold text-3xl md:text-4xl text-white">Game Trailer</h1>
    </div>

    <iframe
        loading="lazy" 
        class="w-[18rem] md:w-[42rem] h-[12rem] md:h-[24rem]"
        src="https://www.youtube.com/embed/sgWAqelrR18?si=JBAc3swTzwDKsgwh"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
</section>
